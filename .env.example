## Copy to `.env.local` for local development.
## Do NOT commit real secrets.

# Postgres (Drizzle + `npm run seed:prompts`). Supabase: Settings → Database → URI (pooler ok).
DATABASE_URL=

# NextAuth (GitHub / Google / email-password). Generate secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth — https://github.com/settings/developers → New OAuth App
# Homepage: NEXTAUTH_URL (e.g. http://localhost:3000)
# Callback: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Built-in admin (email + password / Credentials provider). Min 8 chars for password.
# Multiple admins: comma-separated emails (must match the address you sign in with exactly).
# - On server start and each admin email/password login: password hash is synced from ADMIN_PASSWORD.
# - Production (Cloudflare Workers etc.): set DATABASE_URL, NEXTAUTH_URL, NEXTAUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD as Worker secrets.
# - If login still fails online: run `npm run seed:admin` with the same DATABASE_URL, then redeploy/restart.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change_me_8plus
ADMIN_NAME=Admin

# Public site URL (used for SEO/canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image assets are stored in the Cloudflare R2 binding `IMAGE_ASSETS`.
# Configure the bucket name in wrangler.jsonc; no R2 access key is needed inside the Worker.
# Local `next dev` uses Wrangler's local R2 emulation through initOpenNextCloudflareForDev().
# Anonymous private assets use an HttpOnly signed owner cookie. If omitted, NEXTAUTH_SECRET is used.
ASSET_OWNER_COOKIE_SECRET=
# Optional bearer token for scheduled POST /api/assets/cleanup calls. Admin sessions remain supported.
# Generate with: openssl rand -hex 32
ASSET_CLEANUP_SECRET=

# Default image provider used when client selects `internal`
# Supported: openai-compatible, atlascloud, replicate
DEFAULT_IMAGE_PROVIDER=openai-compatible

# Credits limits (ONLY enforced for internal mode; user-provided apiKey overrides bypass limits)
# Leave empty (or set to 0) for unlimited / disabled.
INTERNAL_DAILY_IMAGE_CREDITS=
INTERNAL_MONTHLY_IMAGE_CREDITS=

# Secret used to sign per-user credits cookie (required in production if any INTERNAL_*_CREDITS is set)
# Generate with: openssl rand -hex 32
CREDITS_COOKIE_SECRET=replace_with_random_hex

# Test mode (skip real providers)
USE_TEST_MODE=false
TEST_IMAGE_URL=https://example.com/test.png

# API key required by the remote Streamable HTTP MCP endpoint (`/api/mcp`).
# Generate with: openssl rand -hex 32
MCP_API_KEY=
# Stable asset owner used by MCP generation tools, e.g. anon:<uuid> or user:<uuid>.
# Required for create_generation and poll_generation; keep it stable across deployments.
MCP_ASSET_OWNER_ID=
# Optional browser origin allowed to call the MCP endpoint.
MCP_ALLOWED_ORIGIN=

## OpenAI-compatible image generation (server-side configuration)
OPENAI_IMAGE_BASE_URL=https://api.openai.com
OPENAI_IMAGE_API_KEY=your_openai_image_api_key
OPENAI_IMAGE_MODEL=gpt-image-2

## Atlascloud (optional image provider)
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1/model
# ATLASCLOUD_API_KEY=your_atlascloud_api_key
# Reference-image field inside AtlasCloud's `input` object (default: image_urls).
# ATLASCLOUD_REFERENCE_IMAGE_FIELD=image_urls

## Replicate (optional image provider)
# REPLICATE_API_TOKEN=your_replicate_api_token
# REPLICATE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_VERSION=
# Input field for image-capable Replicate models (default: image).
# REPLICATE_IMAGE_INPUT_FIELD=image

## OpenAI (video / other features in this repo)
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_MODEL=sora-1.0-turbo
OPENAI_API_BASE_URL=https://api.openai.com

